cmake_minimum_required(VERSION 3.20)
project(Dinero LANGUAGES CXX)

# C++ standard (C++20 required for RocksDB)
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

# Build options - simplified and focused
option(ENABLE_SANITIZERS "Enable ASan/UBSan for debug builds" OFF)

# Platform-specific definitions
if(WIN32)
  add_definitions(-D_WIN32_WINNT=0x0A00)
  add_definitions(-DWIN32_LEAN_AND_MEAN)
elseif(APPLE)
  set(CMAKE_OSX_DEPLOYMENT_TARGET "12.0")
endif()

# Include directories
include_directories(${CMAKE_SOURCE_DIR}/vendor/include)
include_directories(${CMAKE_SOURCE_DIR}/include)
# NOTE: /opt/homebrew/include is NOT globally included to avoid conflicts with vendored libs
# Add it per-target only where needed (jsoncpp, secp256k1)

# Version configuration
string(TIMESTAMP BUILD_TIME "%Y-%m-%dT%H:%M:%S%z" UTC)
find_package(Git QUIET)
if(GIT_FOUND)
  execute_process(COMMAND ${GIT_EXECUTABLE} rev-parse --short HEAD
                  WORKING_DIRECTORY ${CMAKE_SOURCE_DIR}
                  OUTPUT_VARIABLE GIT_HASH OUTPUT_STRIP_TRAILING_WHITESPACE)
else()
  set(GIT_HASH "unknown")
endif()
set(PROJECT_VERSION "0.1.0")

# Version variables for configure_file
set(CLIENT_VERSION_MAJOR 1)
set(CLIENT_VERSION_MINOR 0)
set(CLIENT_VERSION_REVISION 0)
set(CLIENT_VERSION_BUILD 0)
set(CLIENT_VERSION_IS_RELEASE 0)
set(BUILD_DATE "${BUILD_TIME}")
set(GIT_COMMIT_ID "${GIT_HASH}")

# Version config - generate to build root so it's easily found
configure_file(${CMAKE_SOURCE_DIR}/include/compat/version_config.h.in
               ${CMAKE_BINARY_DIR}/version_config.h @ONLY)

# Include generated directory
include_directories(${CMAKE_BINARY_DIR})

# Build vendored RocksDB as static library
set(WITH_TESTS OFF CACHE BOOL "Disable RocksDB tests")
set(WITH_TOOLS OFF CACHE BOOL "Disable RocksDB tools")
set(WITH_BENCHMARK_TOOLS OFF CACHE BOOL "Disable RocksDB benchmarks")
set(WITH_CORE_TOOLS OFF CACHE BOOL "Disable RocksDB core tools")
set(WITH_GFLAGS OFF CACHE BOOL "Disable gflags")
set(WITH_LZ4 OFF CACHE BOOL "Disable LZ4 compression - avoiding NuGet DLL dependency")
set(ROCKSDB_BUILD_SHARED OFF CACHE BOOL "Build static library only")
set(FAIL_ON_WARNINGS OFF CACHE BOOL "Don't fail on warnings")
if(APPLE)
  set(FORCE_NO_LIBATOMIC ON CACHE BOOL "macOS has builtin atomics")
endif()
add_subdirectory(third_party/rocksdb EXCLUDE_FROM_ALL)

# Create version macros for main.cpp
set(PROJECT_VERSION "\"${PROJECT_VERSION}\"")
set(GIT_HASH "\"${GIT_HASH}\"")
set(BUILD_TIME "\"${BUILD_TIME}\"")

# Core crypto library (minimal, vendored crypto)
add_library(dinero_crypto STATIC
  src/crypto/sha256.cpp
  src/crypto/ripemd160_standalone.cpp
  src/crypto/params_stub.cpp
  src/crypto/bip39.cpp
  src/crypto/bip32_slip132.cpp
  src/crypto/hd_keychain.cpp
  src/crypto/base58.cpp
  src/core/crypto/ripemd160.cpp
  src/core/crypto/dinero_crypto_minimal.cpp
  external/bech32/bech32.cpp
  src/crypto/sha256_simd.cpp
  src/crypto/sha256_neon.cpp
  src/crypto/sha256_arm_shani.cpp
  src/crypto/sha256_arm_shani_wrapper.cpp
)

# Enable ARM Crypto Extensions on ARM64 platforms
if(CMAKE_SYSTEM_PROCESSOR MATCHES "arm64|aarch64|ARM64")
    if(APPLE)
        target_compile_options(dinero_crypto PRIVATE -march=armv8-a+crypto)
        target_compile_definitions(dinero_crypto PRIVATE ENABLE_ARM_SHANI)
        message(STATUS "  ⚡ ARM SHA Extensions enabled (hardware acceleration)")
    endif()
endif()

target_include_directories(dinero_crypto PUBLIC
  ${CMAKE_SOURCE_DIR}/include
  ${CMAKE_SOURCE_DIR}/src
  ${CMAKE_SOURCE_DIR}
  ${CMAKE_SOURCE_DIR}/third_party
  ${CMAKE_SOURCE_DIR}/external
)

# Fix secp256k1 static linkage on Windows
if(WIN32)
  target_compile_definitions(dinero_crypto PUBLIC SECP256K1_API=extern)
endif()

# Core wallet library (real implementations only)
add_library(dinero_wallet STATIC
  src/core/wallet/address.cpp
  src/core/wallet/descriptor_wallet.cpp
  src/core/wallet/wallet_manager.cpp
  src/wallet/hd_wallet.cpp
  src/wallet/bip39.cpp
  src/wallet/psbt.cpp
  src/wallet/transaction.cpp
  src/wallet/transaction_deserializer.cpp
  src/wallet/coin_selection.cpp
  src/wallet/bip143_signer.cpp
  src/crypto/pbkdf2.cpp
  src/wallet/wallet_worker.cpp
  src/rpc/address_validation.cpp
)

# P2P globals library (shared between daemon and RPC handlers)
add_library(dinero_p2p_globals STATIC
  src/p2p/p2p_globals.cpp
)
target_include_directories(dinero_p2p_globals PUBLIC
  ${CMAKE_SOURCE_DIR}/include
  ${CMAKE_SOURCE_DIR}/src
)

# RPC handlers library (includes GUI-compatible handlers)
add_library(dinero_rpc_handlers STATIC
  src/daemon/rpc/wallet_gui_handlers.cpp
  src/daemon/rpc/MiningExtrasHandlers.cpp
  src/core/rpc/validation_rpc_handlers.cpp
)
target_include_directories(dinero_rpc_handlers PUBLIC
  ${CMAKE_SOURCE_DIR}/include
  ${CMAKE_SOURCE_DIR}/src
)
target_link_libraries(dinero_rpc_handlers PUBLIC dinero_wallet dinero_crypto dinero_p2p_globals)

# RPC client library (for CLI and GUI)
add_library(dinero_rpc_client STATIC
  src/rpc_client.cpp
)
target_include_directories(dinero_rpc_client PUBLIC
  ${CMAKE_SOURCE_DIR}/include
  ${CMAKE_SOURCE_DIR}/src
)
if(APPLE)
  target_link_libraries(dinero_rpc_client PUBLIC /opt/homebrew/lib/libjsoncpp.dylib)
elseif(WIN32)
  target_link_libraries(dinero_rpc_client PUBLIC C:/vcpkg/installed/x64-windows-static-md/lib/jsoncpp.lib)
else()
  target_link_libraries(dinero_rpc_client PUBLIC jsoncpp)
endif()

target_include_directories(dinero_wallet PUBLIC ${CMAKE_SOURCE_DIR}/include ${CMAKE_SOURCE_DIR}/src)
target_link_libraries(dinero_wallet PUBLIC dinero_crypto dinero_consensus OpenSSL::SSL OpenSSL::Crypto)

# Fix secp256k1 static linkage on Windows
if(WIN32)
  target_compile_definitions(dinero_wallet PUBLIC SECP256K1_API=extern)
endif()

# Consensus library (UTXO validation + ChainDB storage)
add_library(dinero_consensus STATIC
  src/consensus/chainparams_impl.cpp  # CANONICAL chainparams implementation
  src/consensus/chainwork.cpp          # arith_uint256 for difficulty calculations
  src/consensus/block_undo.cpp
  # src/consensus/block_validation.cpp  # Disabled - uses old Block API (needs rewrite for ChainDB Block struct)
  src/consensus/tx_parser.cpp
  src/consensus/script_verify.cpp
  src/consensus/transaction_validator.cpp
  src/wallet/utxo_index.cpp
  src/sqlite_open.cpp
  src/crypto/ripemd160.cpp
  src/storage/chain_db.cpp
  src/common/serialization.cpp
  src/primitives/block.cpp
  src/common/sha256d.cpp
)

target_include_directories(dinero_consensus PUBLIC
  ${CMAKE_SOURCE_DIR}/include
  ${CMAKE_SOURCE_DIR}/src
  ${CMAKE_SOURCE_DIR}/src/daemon
)

# Fix secp256k1 static linkage on Windows
if(WIN32)
  target_compile_definitions(dinero_consensus PUBLIC SECP256K1_API=extern)
endif()

if(APPLE)
  target_link_libraries(dinero_consensus PUBLIC
    dinero_crypto
    /opt/homebrew/lib/libjsoncpp.dylib
    /opt/homebrew/lib/libsecp256k1.dylib
    rocksdb
    sqlite3
  )
elseif(WIN32)
  target_link_libraries(dinero_consensus PUBLIC
    dinero_crypto
    C:/vcpkg/installed/x64-windows-static-md/lib/jsoncpp.lib
    C:/vcpkg/installed/x64-windows-static-md/lib/secp256k1.lib
    C:/vcpkg/installed/x64-windows-static-md/lib/secp256k1_precomputed.lib
    rocksdb
    C:/vcpkg/installed/x64-windows-static-md/lib/sqlite3.lib
  )
else()
  target_link_libraries(dinero_consensus PUBLIC
    dinero_crypto
    jsoncpp
    secp256k1
    rocksdb
    sqlite3
  )
endif()

# Minimal daemon executable (only working components)
if(APPLE)
  add_executable(dinerod
    src/daemon/main.cpp
    src/daemon/http_rpc_server.cpp
    src/daemon/p2p_manager.cpp
    src/daemon/transaction_pool.cpp
    src/daemon/bech32_encoder.cpp
    src/daemon/secure_random.cpp
    src/daemon/crypto_utils.cpp
    src/daemon/rpc_auth.cpp
    src/daemon/consensus_subsidy.cpp
    src/daemon/simple_wallet.cpp
    src/daemon/hd_wallet_manager.cpp
    src/daemon/wallet_crypto.cpp
    src/daemon/block_acceptor.cpp
    src/daemon/db_meta_utils.cpp
    src/daemon/genesis_init.cpp
    src/metrics/metrics_registry.cpp
    src/common/logger.cpp
    src/common/address_script_builder.cpp
    src/consensus/undo.cpp
    # Mining validation (Phase 2 Hardening)
    src/mining/template_validator.cpp
    # P2P globals (Phase 2 - required by validation handlers)
    src/p2p/p2p_globals.cpp
    # WebSocket support
    src/daemon/ws/ws_server.cpp
    src/daemon/ws_subscriptions.cpp
    src/daemon/ws_globals.cpp
    src/daemon/gui_websocket_events.cpp
    src/daemon/rpc/websocket_handlers.cpp
    src/daemon/ws_stubs.cpp
  )
else()
  # Linux server build (no wallet encryption - server doesn't hold keys)
  add_executable(dinerod
    src/daemon/main.cpp
    src/daemon/http_rpc_server.cpp
    src/daemon/p2p_manager.cpp
    src/daemon/transaction_pool.cpp
    src/daemon/bech32_encoder.cpp
    src/daemon/secure_random.cpp
    src/daemon/crypto_utils.cpp
    src/daemon/rpc_auth.cpp
    src/daemon/consensus_subsidy.cpp
    src/daemon/simple_wallet.cpp
    src/daemon/block_acceptor.cpp
    src/daemon/db_meta_utils.cpp
    src/daemon/genesis_init.cpp
    src/metrics/metrics_registry.cpp
    src/common/logger.cpp
    src/common/address_script_builder.cpp
    src/consensus/undo.cpp
    src/p2p/p2p_globals.cpp
    # Mining validation (Phase 2 Hardening)
    src/mining/template_validator.cpp
    # WebSocket support
    src/daemon/ws/ws_server.cpp
    src/daemon/ws_subscriptions.cpp
    src/daemon/ws_globals.cpp
    src/daemon/gui_websocket_events.cpp
    src/daemon/rpc/websocket_handlers.cpp
    src/daemon/ws_stubs.cpp
    # hd_wallet_manager.cpp excluded (depends on wallet_crypto)
    # wallet_crypto.cpp excluded (needs OpenSSL 3.2+)
  )
  add_compile_definitions(NO_WALLET_ENCRYPTION)
endif()

# Link only what we actually have implementations for
# dinero_wallet already depends on dinero_crypto, so we don't link dinero_crypto twice
if(APPLE)
  target_link_libraries(dinerod PRIVATE
    dinero_consensus
    dinero_wallet
    dinero_rpc_handlers
    dinero_p2p_globals
    /opt/homebrew/lib/libjsoncpp.dylib
    /opt/homebrew/lib/libsecp256k1.dylib
  )
elseif(WIN32)
  target_link_libraries(dinerod PRIVATE
    dinero_consensus
    dinero_wallet
    dinero_rpc_handlers
    C:/vcpkg/installed/x64-windows-static-md/lib/jsoncpp.lib
    C:/vcpkg/installed/x64-windows-static-md/lib/secp256k1.lib
    C:/vcpkg/installed/x64-windows-static-md/lib/secp256k1_precomputed.lib
  )
else()
  target_link_libraries(dinerod PRIVATE
    dinero_consensus
    dinero_wallet
    dinero_rpc_handlers
    jsoncpp
    secp256k1
  )
endif()

# Add generated headers include directory
target_include_directories(dinerod PRIVATE ${CMAKE_BINARY_DIR}/generated)

# Platform-specific linking with proper crypto libraries
find_package(OpenSSL REQUIRED)

# Boost is required for WebSocket support (ASIO) on all platforms
find_package(Boost 1.70 REQUIRED COMPONENTS system)
if(APPLE)
  target_link_libraries(dinerod PRIVATE Boost::system)
  target_compile_definitions(dinerod PRIVATE BOOST_ASIO_NO_DEPRECATED DIN_WS_RPC=1)
else()
  # Linux needs Boost for WebSocket support too
  target_link_libraries(dinerod PRIVATE Boost::system)
  target_compile_definitions(dinerod PRIVATE BOOST_ASIO_NO_DEPRECATED DIN_WS_RPC=1)
endif()

# Wallet encryption uses PBKDF2-HMAC-SHA512 (built into OpenSSL, no external dependencies)

# Find jsoncpp (required for RPC)
find_package(PkgConfig QUIET)
if(PKG_CONFIG_FOUND)
    pkg_check_modules(JSONCPP jsoncpp)
endif()

# Fallback if pkg-config doesn't find it
if(NOT JSONCPP_FOUND)
    find_path(JSONCPP_INCLUDE_DIR json/json.h 
        PATHS /usr/include/jsoncpp /usr/local/include/jsoncpp)
    find_library(JSONCPP_LIBRARY jsoncpp)
    if(JSONCPP_INCLUDE_DIR AND JSONCPP_LIBRARY)
        set(JSONCPP_FOUND TRUE)
        set(JSONCPP_INCLUDE_DIRS ${JSONCPP_INCLUDE_DIR})
        set(JSONCPP_LIBRARIES ${JSONCPP_LIBRARY})
    endif()
endif()

if(JSONCPP_FOUND)
    message(STATUS "Found jsoncpp: ${JSONCPP_LIBRARIES}")
    include_directories(${JSONCPP_INCLUDE_DIRS})
    # On Windows with vcpkg, add library directories
    if(WIN32 AND JSONCPP_LIBRARY_DIRS)
        link_directories(${JSONCPP_LIBRARY_DIRS})
    endif()
else()
    message(WARNING "jsoncpp not found, using system includes")
endif()
# OpenSSL and SQLite3 linkage
target_link_libraries(dinerod PRIVATE
  OpenSSL::SSL
  OpenSSL::Crypto
)

# Platform-specific threading and database libraries
if(WIN32)
  target_link_libraries(dinerod PRIVATE
    C:/vcpkg/installed/x64-windows-static-md/lib/sqlite3.lib
  )
else()
  target_link_libraries(dinerod PRIVATE
    pthread
    sqlite3
  )
endif()

# Windows: sockets + CSPRNG
if(WIN32)
  target_compile_definitions(dinerod PRIVATE WIN32_LEAN_AND_MEAN NOMINMAX)
  target_link_libraries(dinerod PRIVATE ws2_32 bcrypt)
endif()

# Add version compile definitions
target_compile_definitions(dinerod PRIVATE
  DIN_VERSION=${PROJECT_VERSION}
  DIN_GIT_HASH=${GIT_HASH}
  DIN_BUILD_TIME=${BUILD_TIME}
)

# macOS: Security framework for SecRandomCopyBytes
if(APPLE)
  find_library(SECURITY_FRAMEWORK Security)
  if(SECURITY_FRAMEWORK)
    target_link_libraries(dinerod PRIVATE ${SECURITY_FRAMEWORK})
  endif()
endif()

# Sanitizers for debug builds
if(ENABLE_SANITIZERS AND CMAKE_BUILD_TYPE STREQUAL "Debug")
  target_compile_options(dinerod PRIVATE -fsanitize=address -fsanitize=undefined)
  target_link_options(dinerod PRIVATE -fsanitize=address -fsanitize=undefined)
endif()

# Genesis miner tool
add_executable(genesis_miner tools/genesis_miner.cpp)
target_link_libraries(genesis_miner PRIVATE dinero_consensus dinero_crypto pthread)
target_include_directories(genesis_miner PRIVATE ${CMAKE_SOURCE_DIR}/src)

# CPU miner (external process)
add_executable(dinero-miner tools/dinero_miner.cpp)
if(APPLE)
  target_link_libraries(dinero-miner PRIVATE
    dinero_crypto
    /opt/homebrew/lib/libjsoncpp.dylib
    curl
  )
  target_include_directories(dinero-miner PRIVATE
    ${CMAKE_SOURCE_DIR}/src
    ${CMAKE_SOURCE_DIR}/external
    /opt/homebrew/include
  )
else()
  target_link_libraries(dinero-miner PRIVATE
    dinero_crypto
    jsoncpp
    curl
  )
  target_include_directories(dinero-miner PRIVATE
    ${CMAKE_SOURCE_DIR}/src
    ${CMAKE_SOURCE_DIR}/external
  )
endif()

# CLI tool (uses unified RPC client)
add_executable(dinero-cli src/dinero_cli.cpp)
if(APPLE)
  target_link_libraries(dinero-cli PRIVATE
    dinero_rpc_client
    /opt/homebrew/lib/libjsoncpp.dylib
  )
else()
  target_link_libraries(dinero-cli PRIVATE
    dinero_rpc_client
    jsoncpp
  )
endif()
target_include_directories(dinero-cli PRIVATE
  ${CMAKE_SOURCE_DIR}/include
  ${CMAKE_SOURCE_DIR}/src
)

# SIMD benchmark tool
add_executable(bench-simd tools/bench_simd.cpp)
target_link_libraries(bench-simd PRIVATE dinero_crypto)
target_include_directories(bench-simd PRIVATE ${CMAKE_SOURCE_DIR}/src)

# Qt6 GUI (optional - only if Qt6 is available)
option(BUILD_GUI "Build Qt6 GUI" ON)
if(BUILD_GUI)
  find_package(Qt6 QUIET COMPONENTS Widgets Network)
  if(Qt6_FOUND)
    message(STATUS "Qt6 found - building GUI")
    add_subdirectory(gui)
  else()
    message(STATUS "Qt6 not found - skipping GUI build")
  endif()
endif()

# Installation
install(TARGETS dinerod dinero-cli genesis_miner dinero-miner bench-simd DESTINATION bin)

# Tests (only if we have working test files)
enable_testing()

