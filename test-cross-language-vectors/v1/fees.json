      "weight_breakdown": {
        "overhead": 42,
        "inputs": 2300,
        "outputs": 172,
        "total": 2514
      }
    },
    {
      "name": "mixed_inputs",
      "description": "Mixed input types: 2 P2TR + 1 P2WPKH inputs, 2 outputs",
      "template": {
        "p2tr_inputs": 2,
        "p2wpkh_inputs": 1,
        "p2tr_outputs": 2,
        "p2wpkh_outputs": 0,
        "has_op_return": false,
        "op_return_size": 0
      },
      "fee_rate_una_per_vb": 3,
      "expected_weight": 1117,
      "expected_vbytes": 280,
      "expected_fee": 840,
      "weight_breakdown": {
        "overhead": 42,
        "p2tr_inputs": 460,
        "p2wpkh_inputs": 271,
        "outputs": 344,
        "total": 1117
      }
    }
  ],
  "marginal_fees": [
    {
      "name": "marginal_p2tr_input_1_sat",
      "description": "Cost to add one P2TR input at 1 una/vB",
      "fee_rate_una_per_vb": 1,
      "input_weight": 230,
      "expected_fee": 58,
      "formula": "ceil(230 * 1 / 4) = ceil(57.5) = 58"
    },
    {
      "name": "marginal_p2tr_input_5_sat",
      "description": "Cost to add one P2TR input at 5 una/vB",
      "fee_rate_una_per_vb": 5,
      "input_weight": 230,
      "expected_fee": 288,
      "formula": "ceil(230 * 5 / 4) = ceil(287.5) = 288"
    },
    {
      "name": "marginal_p2tr_input_10_sat",
      "description": "Cost to add one P2TR input at 10 una/vB",
      "fee_rate_una_per_vb": 10,
      "input_weight": 230,
      "expected_fee": 575,
      "formula": "ceil(230 * 10 / 4) = ceil(575) = 575"
    },
    {
      "name": "marginal_p2tr_output_1_sat",
      "description": "Cost to add one P2TR output at 1 una/vB",
      "fee_rate_una_per_vb": 1,
      "output_weight": 172,
      "expected_fee": 43,
      "formula": "ceil(172 * 1 / 4) = ceil(43) = 43"
    },
    {
      "name": "marginal_p2tr_output_5_sat",
      "description": "Cost to add one P2TR output at 5 una/vB",
      "fee_rate_una_per_vb": 5,
      "output_weight": 172,
      "expected_fee": 215,
      "formula": "ceil(172 * 5 / 4) = ceil(215) = 215"
    },
    {
      "name": "marginal_p2wpkh_input_1_sat",
      "description": "Cost to add one P2WPKH input at 1 una/vB",
      "fee_rate_una_per_vb": 1,
      "input_weight": 271,
      "expected_fee": 68,
      "formula": "ceil(271 * 1 / 4) = ceil(67.75) = 68"
    },
    {
      "name": "marginal_p2wpkh_output_1_sat",
      "description": "Cost to add one P2WPKH output at 1 una/vB",
      "fee_rate_una_per_vb": 1,
      "output_weight": 124,
      "expected_fee": 31,
      "formula": "ceil(124 * 1 / 4) = ceil(31) = 31"
    }
  ],
  "effective_value": [
    {
      "name": "10k_utxo_1_sat",
      "description": "Effective value of 10,000 una UTXO at 1 una/vB",
      "utxo_amount": 10000,
