        "p2tr_outputs": 2,
        "p2wpkh_outputs": 0,
        "has_op_return": false,
        "op_return_size": 0
      },
      "fee_rate_una_per_vb": 10,
      "expected_weight": 616,
      "expected_vbytes": 154,
      "expected_fee": 1540
    },
    {
      "name": "consolidation_3_inputs",
      "description": "Consolidation: 3 P2TR inputs to 1 output",
      "template": {
        "p2tr_inputs": 3,
        "p2wpkh_inputs": 0,
        "p2tr_outputs": 1,
        "p2wpkh_outputs": 0,
        "has_op_return": false,
        "op_return_size": 0
      },
      "fee_rate_una_per_vb": 1,
      "expected_weight": 904,
      "expected_vbytes": 226,
      "expected_fee": 226,
      "weight_breakdown": {
        "overhead": 42,
        "inputs": 690,
        "outputs": 172,
        "total": 904
      }
    },
    {
      "name": "mixed_outputs",
      "description": "Mixed output types: 3 P2TR inputs, 1 P2TR + 1 P2WPKH outputs",
      "template": {
        "p2tr_inputs": 3,
        "p2wpkh_inputs": 0,
        "p2tr_outputs": 1,
        "p2wpkh_outputs": 1,
        "has_op_return": false,
        "op_return_size": 0
      },
      "fee_rate_una_per_vb": 2,
      "expected_weight": 1028,
      "expected_vbytes": 257,
      "expected_fee": 514,
      "weight_breakdown": {
        "overhead": 42,
        "inputs": 690,
        "p2tr_outputs": 172,
        "p2wpkh_outputs": 124,
        "total": 1028
      }
    },
    {
      "name": "with_op_return",
      "description": "Transaction with OP_RETURN data (20 bytes)",
      "template": {
        "p2tr_inputs": 1,
        "p2wpkh_inputs": 0,
        "p2tr_outputs": 1,
        "p2wpkh_outputs": 0,
        "has_op_return": true,
        "op_return_size": 20
      },
      "fee_rate_una_per_vb": 1,
      "expected_weight": 564,
      "expected_vbytes": 141,
      "expected_fee": 141,
      "weight_breakdown": {
        "overhead": 42,
        "inputs": 230,
        "outputs": 172,
        "op_return_base": 40,
        "op_return_data": 80,
        "total": 564
      }
    },
    {
      "name": "minimal_tx",
      "description": "Minimal transaction: 1 input, 1 output",
      "template": {
        "p2tr_inputs": 1,
        "p2wpkh_inputs": 0,
        "p2tr_outputs": 1,
        "p2wpkh_outputs": 0,
        "has_op_return": false,
        "op_return_size": 0
      },
      "fee_rate_una_per_vb": 1,
      "expected_weight": 444,
      "expected_vbytes": 111,
      "expected_fee": 111
