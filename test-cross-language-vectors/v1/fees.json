{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "description": "Fee calculation test vectors for DineroCoin. All implementations MUST produce identical fee estimates for these inputs.",
  "formulas": {
    "vbytes_from_weight": "vbytes = ceil(weight / 4) = (weight + 3) / 4",
    "fee_from_vbytes": "fee = vbytes * fee_rate",
    "fee_from_weight": "fee = ceil(weight * fee_rate / 4) = (weight * fee_rate + 3) / 4",
    "weight_calculation": "weight = TX_OVERHEAD + sum(input_weights) + sum(output_weights) + op_return_weight"
  },
  "constants": {
    "TX_OVERHEAD_WEIGHT": 42,
    "P2TR_INPUT_WEIGHT": 230,
    "P2WPKH_INPUT_WEIGHT": 271,
    "P2TR_OUTPUT_WEIGHT": 172,
    "P2WPKH_OUTPUT_WEIGHT": 124,
    "OP_RETURN_BASE_WEIGHT": 40,
    "P2TR_DUST_THRESHOLD": 546,
    "P2WPKH_DUST_THRESHOLD": 546,
    "MIN_RELAY_FEE_RATE": 1,
    "description": "Weight in WU, dust/fee in una, fee_rate in una/vB"
  },
  "fee_estimates": [
    {
      "name": "simple_payment_1_sat_vb",
      "description": "Standard P2TR payment: 1 input, 2 outputs (payment + change) at 1 una/vB",
      "template": {
        "p2tr_inputs": 1,
        "p2wpkh_inputs": 0,
        "p2tr_outputs": 2,
        "p2wpkh_outputs": 0,
        "has_op_return": false,
        "op_return_size": 0
      },
      "fee_rate_una_per_vb": 1,
      "expected_weight": 616,
      "expected_vbytes": 154,
      "expected_fee": 154,
      "weight_breakdown": {
        "overhead": 42,
        "inputs": 230,
        "outputs": 344,
        "total": 616
      }
    },
    {
      "name": "simple_payment_5_sat_vb",
      "description": "Standard P2TR payment at 5 una/vB (medium priority)",
      "template": {
        "p2tr_inputs": 1,
        "p2wpkh_inputs": 0,
        "p2tr_outputs": 2,
        "p2wpkh_outputs": 0,
        "has_op_return": false,
        "op_return_size": 0
      },
      "fee_rate_una_per_vb": 5,
      "expected_weight": 616,
      "expected_vbytes": 154,
      "expected_fee": 770
    },
    {
      "name": "simple_payment_10_sat_vb",
