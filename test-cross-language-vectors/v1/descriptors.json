  "notes": {
    "bip86": "BIP86 defines single-key P2TR (Taproot) wallets with key-path-only spending. The output key is tweaked: output = internal + H_TapTweak(internal)*G",
    "coin_type": "1448 is the official registered coin type for DineroCoin (v7) in SLIP-0044.",
    "bech32m": "All P2TR addresses use Bech32m encoding (BIP350) with witness version 1.",
    "x_only_pubkey": "Taproot uses 32-byte x-only public keys (BIP340). The y-coordinate parity is implicit.",
    "taproot_tweak": "For key-path-only BIP86, the tweak is H_TapTweak(internal_key) with no script tree.",
    "verification": "Run 'cargo test --test cross_language_vectors' in crates/dpi to validate these vectors."
