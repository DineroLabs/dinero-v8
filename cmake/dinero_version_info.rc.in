// Auto-generated Windows resource file. Do NOT edit dinero_version_info.rc
// in the build tree — edit cmake/dinero_version_info.rc.in (the template)
// and re-run CMake. Per-target values are filled in by
// dinero_attach_win32_versioninfo() in the top-level CMakeLists.txt.
//
// Why embed this: without a VS_VERSION_INFO resource, right-click the
// .exe -> Properties -> Details shows entirely empty fields. With one,
// Windows Explorer, Task Manager (publisher column), and tooling that
// reads PE version metadata (Get-Item ... .VersionInfo) all surface
// the correct version, company, and component description.

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @DINERO_VI_FILEVERSION@
 PRODUCTVERSION @DINERO_VI_PRODUCTVERSION@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "DineroLabs"
            VALUE "FileDescription",  "@DINERO_VI_DESCRIPTION@"
            VALUE "FileVersion",      "@DINERO_VI_VERSION_STRING@"
            VALUE "InternalName",     "@DINERO_VI_INTERNAL_NAME@"
            VALUE "LegalCopyright",   "Copyright (C) 2026 DineroLabs"
            VALUE "OriginalFilename", "@DINERO_VI_ORIGINAL_FILENAME@"
            VALUE "ProductName",      "Dinero"
            VALUE "ProductVersion",   "@DINERO_VI_VERSION_STRING@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
