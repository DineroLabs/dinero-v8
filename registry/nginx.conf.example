# Nginx configuration for Dinero Registry (Production)
# Copy to /etc/nginx/sites-available/dinero-registry

# Rate limiting zones
limit_req_zone $binary_remote_addr zone=api:10m rate=60r/m;
limit_req_zone $binary_remote_addr zone=register:10m rate=10r/m;

# Upstream backend
upstream registry_backend {
    server localhost:8080 max_fails=3 fail_timeout=30s;
    keepalive 32;
}

# HTTP -> HTTPS redirect
server {
    listen 80;
    listen [::]:80;
    server_name status.dinero-coin.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$server_name$request_uri;
    }
}

# HTTPS server
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name status.dinero-coin.com;

    # SSL configuration
    ssl_certificate /etc/letsencrypt/live/status.dinero-coin.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/status.dinero-coin.com/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/status.dinero-coin.com/chain.pem;

    # SSL settings
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384';
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_stapling on;
    ssl_stapling_verify on;

    # Security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;

    # CORS headers
    add_header Access-Control-Allow-Origin "*" always;
    add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Content-Type, X-Signature" always;

    # Logging
    access_log /var/log/nginx/dinero-registry-access.log;
    error_log /var/log/nginx/dinero-registry-error.log;

    # Root location (dashboard)
    location / {
        limit_req zone=api burst=10 nodelay;
        proxy_pass http://registry_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_connect_timeout 5s;
        proxy_send_timeout 10s;
        proxy_read_timeout 10s;
    }

    # API endpoints (stricter rate limiting)
    location /api/ {
        limit_req zone=api burst=20 nodelay;
        proxy_pass http://registry_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Cache GET requests for 30 seconds
        proxy_cache_methods GET;
        proxy_cache_valid 200 30s;
    }

    # Registration endpoint (very strict rate limiting)
    location /api/register {
        limit_req zone=register burst=5 nodelay;
        proxy_pass http://registry_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # No caching for POST
        proxy_cache_bypass $http_pragma $http_authorization;
        proxy_no_cache $http_pragma $http_authorization;
    }

    # Static JSON files (cache for 10 seconds)
    location ~ \.(json)$ {
        limit_req zone=api burst=30 nodelay;
        proxy_pass http://registry_backend;
        proxy_cache_valid 200 10s;
        add_header Cache-Control "public, max-age=10";
    }

    # Health check (no rate limit)
    location = /api/status {
        proxy_pass http://registry_backend;
        access_log off;
    }

    # Block access to hidden files
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}

# Setup instructions:
#
# 1. Install nginx and certbot:
#    sudo apt install nginx certbot python3-certbot-nginx
#
# 2. Copy this file:
#    sudo cp nginx.conf.example /etc/nginx/sites-available/dinero-registry
#
# 3. Enable site:
#    sudo ln -s /etc/nginx/sites-available/dinero-registry /etc/nginx/sites-enabled/
#
# 4. Get SSL certificate:
#    sudo certbot --nginx -d status.dinero-coin.com
#
# 5. Test configuration:
#    sudo nginx -t
#
# 6. Reload nginx:
#    sudo systemctl reload nginx
#
# 7. Set up auto-renewal:
#    sudo systemctl enable certbot.timer
#
# Monitor logs:
#    sudo tail -f /var/log/nginx/dinero-registry-*.log
