{
 "_doc": "CV3 entry points (survey sections 3-4). Patterns are qualified to avoid same-named members; exclude = definition and declaration files.",
 "roots": [
  "dinerod"
 ],
 "entry_points": [
  {
   "id": "TXV-validateTransaction",
   "pattern": "\\bconsensus::validateTransaction\\s*\\(",
   "exclude": [
    "src/consensus/tx_validation.cpp"
   ]
  },
  {
   "id": "TXV-validateInputs",
   "pattern": "\\bconsensus::validateInputs\\s*\\(",
   "exclude": [
    "src/consensus/tx_validation.cpp"
   ]
  },
  {
   "id": "TXV-checkSequenceLocks",
   "pattern": "\\bconsensus::checkSequenceLocks\\s*\\(",
   "exclude": [
    "src/consensus/tx_validation.cpp"
   ]
  },
  {
   "id": "VerifyBlockStateless",
   "pattern": "\\bVerifyBlockStateless\\s*\\(",
   "exclude": [
    "include/consensus/stateless_verification.h",
    "src/consensus/stateless_verification.cpp"
   ]
  },
  {
   "id": "CheckProofOfWork",
   "pattern": "\\bCheckProofOfWork\\s*\\(",
   "exclude": [
    "include/consensus/pow.h",
    "src/consensus/pow.cpp"
   ]
  },
  {
   "id": "CheckBlockSigops",
   "pattern": "\\bCheckBlockSigops\\s*\\(",
