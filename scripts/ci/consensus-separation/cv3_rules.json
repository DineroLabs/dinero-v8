    "include/consensus/sigops.h",
    "src/consensus/sigops.cpp"
   ]
  },
  {
   "id": "CheckCoinbaseReward",
   "pattern": "\\bCheckCoinbaseReward\\s*\\(",
   "exclude": [
    "include/consensus/block_reward.h",
    "src/consensus/block_reward.cpp"
   ]
  },
  {
   "id": "BlockValidator-ConnectBlock",
   "pattern": "\\bblock_validator_->ConnectBlock\\s*\\(",
   "exclude": []
  },
  {
   "id": "TransactionValidator-ValidateTransaction",
   "pattern": "\\bTransactionValidator::ValidateTransaction\\s*\\(",
   "exclude": [
    "src/consensus/transaction_validator.cpp"
   ]
  },
  {
   "id": "PowConsensusEngine-ValidateBlock",
   "pattern": "(->|[.])ValidateBlock\\s*\\(|\\bPowConsensusEngine::ValidateBlock\\s*\\(",
   "exclude": [
    "src/consensus/pow_consensus_engine.cpp"
   ]
  },
  {
   "id": "isCoinbaseMature",
   "pattern": "\\bisCoinbaseMature\\s*\\(",
   "exclude": [
