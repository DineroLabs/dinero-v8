[Unit]
Description=Dinero Prometheus Metrics Exporter
After=network.target dinerod.service
Wants=dinerod.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/DineroCoin
Environment="NODE_NAME=production"
ExecStart=/usr/bin/python3 /usr/local/bin/dinero-metrics-server.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
