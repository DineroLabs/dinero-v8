#include <windows.h>

// Application icon
IDI_ICON1 ICON "icons/Dinero-Coin.ico"

// Version information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     2,1,2,0
PRODUCTVERSION  2,1,2,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",        "Dinero Project"
            VALUE "FileDescription",   "Dinero Cryptocurrency - Complete Mining Node & Wallet"
            VALUE "FileVersion",       "2.1.2.0"
            VALUE "InternalName",      "dinero-qt6"
            VALUE "LegalCopyright",    "Copyright (C) 2025 Dinero Project"
            VALUE "OriginalFilename",  "dinero-qt6.exe"
            VALUE "ProductName",       "Dinero Cryptocurrency"
            VALUE "ProductVersion",    "2.1.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Application manifest
1 RT_MANIFEST "dinero-qt6.manifest"
