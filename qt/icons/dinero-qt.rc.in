// Auto-generated from qt/icons/dinero-qt.rc.in via CMake configure_file().
// Do NOT edit the configured copy in the build tree; edit the .in template
// and re-run CMake.
//
// Windows resource file for dinero-qt.exe.
//
// Embeds the application icon so Windows Explorer, the Start Menu, the
// taskbar, and Alt-Tab all show the proper Dinero logo before and after
// the app launches. This mirrors the macOS Dinero.icns embedding via
// MACOSX_BUNDLE_ICON_FILE.
//
// IDI_ICON1 (value 1, the lowest-numbered ICON resource) is what the
// Windows shell picks up for the .exe file icon.

IDI_ICON1 ICON "@DINERO_QT_ICO_PATH@"

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @DINERO_VI_FILEVERSION@
 PRODUCTVERSION @DINERO_VI_PRODUCTVERSION@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "DineroLabs"
            VALUE "FileDescription",  "Dinero Qt Wallet"
            VALUE "FileVersion",      "@DINERO_VI_VERSION_STRING@"
            VALUE "InternalName",     "dinero-qt"
            VALUE "LegalCopyright",   "Copyright (C) 2026 DineroLabs"
            VALUE "OriginalFilename", "dinero-qt.exe"
            VALUE "ProductName",      "Dinero"
            VALUE "ProductVersion",   "@DINERO_VI_VERSION_STRING@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
