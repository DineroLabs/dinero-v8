# Dockerfile-specific override of the root .dockerignore, used by BuildKit for
# this Dockerfile ONLY. The full-v6 image copies the exact verification
# scripts and candidate catalog into its fetch stage. Keep the context narrow;
# an omitted file should fail COPY rather than silently remove a trust check.
*
!docker-entrypoint.sh
!packaging/
!packaging/snapshot/
!packaging/snapshot/check_desktop_primary.py
!packaging/snapshot/fetch_desktop_primary.py
!packaging/snapshot/snapshot_transport.py
!packaging/snapshot/fleet-publisher-ed25519.pub.pem
!packaging/snapshot/desktop-inputs-candidate.json
!packaging/docker/
!packaging/docker/check_recovery_manifests.py
!packaging/docker/check_binary_source.sh
!scripts/
!scripts/ci/
!scripts/ci/check_snapshot_freshness.py
