+// Preserve the rand 0.8.8 shuffle for explicitly selected profile-1 recovery.
+// Default builders and new plans retain the upstream current shuffle.
+fn legacy_shuffle<T, R: Rng + ?Sized>(values: &mut [T], rng: &mut R) {
+    struct Adapter<'a, R: ?Sized>(&'a mut R);
+    impl<R: Rng + ?Sized> rand_legacy::RngCore for Adapter<'_, R> {
+        fn next_u32(&mut self) -> u32 { self.0.next_u32() }
+        fn next_u64(&mut self) -> u64 { self.0.next_u64() }
+        fn fill_bytes(&mut self, dest: &mut [u8]) { self.0.fill_bytes(dest); }
+        fn try_fill_bytes(&mut self, dest: &mut [u8]) -> Result<(), rand_legacy::Error> {
+            self.0.fill_bytes(dest); Ok(())
+        }
+    }
+    rand_legacy::seq::SliceRandom::shuffle(values, &mut Adapter(rng));
+}
 
