{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "utxo.lock",
  "description": "Lock specific UTXOs to prevent spending",
  "type": "object",
  "properties": {
    "method": {
      "type": "string",
      "const": "utxo.lock"
    },
    "params": {
      "type": "array",
      "items": [
        {
          "type": "array",
          "description": "UTXOs to lock",
          "items": {
            "type": "object",
            "properties": {
              "txid": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$",
                "description": "Transaction ID"
              },
              "vout": {
                "type": "integer",
                "minimum": 0,
                "description": "Output index"
              }
            },
            "required": ["txid", "vout"]
          },
          "minItems": 1
        },
        {
          "type": "boolean",
          "description": "Whether to unlock instead of lock (default: false)"
        }
      ],
      "minItems": 1,
      "maxItems": 2
    },
    "result": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean",
          "description": "Whether operation completed successfully"
        },
        "locked_count": {
          "type": "integer",
          "description": "Number of UTXOs successfully locked"
        },
        "unlocked_count": {
          "type": "integer",
          "description": "Number of UTXOs successfully unlocked"
        },
        "already_locked": {
          "type": "integer",
          "description": "Number of UTXOs that were already locked"
        },
        "not_found": {
          "type": "integer",
          "description": "Number of UTXOs not found in wallet"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "txid": {"type": "string"},
              "vout": {"type": "integer"},
              "error": {"type": "string"}
            }
          },
          "description": "Per-UTXO errors"
        }
      },
      "required": ["success"]
    }
  }
}
