{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "getwalletinfo",
  "description": "Get wallet status, encryption state, and scanning progress",
  "type": "object",
  "properties": {
    "method": {
      "type": "string",
      "const": "getwalletinfo"
    },
    "params": {
      "type": "array",
      "items": {},
      "maxItems": 0
    },
    "result": {
      "type": "object",
      "properties": {
        "walletname": {
          "type": "string",
          "description": "Wallet filename"
        },
        "walletversion": {
          "type": "integer",
          "description": "Wallet format version"
        },
        "format": {
          "type": "string",
          "enum": ["legacy", "bdb", "sqlite"],
          "description": "Wallet database format"
        },
        "balance_una": {
          "type": "integer",
          "description": "Total balance in una"
        },
        "balance_din": {
          "type": "string",
          "description": "Total balance in DIN (formatted)"
        },
        "unconfirmed_balance_una": {
          "type": "integer",
          "description": "Unconfirmed balance in una"
        },
        "unconfirmed_balance_din": {
          "type": "string",
          "description": "Unconfirmed balance in DIN (formatted)"
        },
        "immature_balance_una": {
          "type": "integer",
          "description": "Immature coinbase balance in una"
        },
        "immature_balance_din": {
          "type": "string",
          "description": "Immature coinbase balance in DIN (formatted)"
        },
        "txcount": {
          "type": "integer",
          "description": "Number of transactions in wallet"
        },
        "keypoololdest": {
          "type": "integer",
          "description": "Timestamp of oldest key in keypool"
        },
        "keypoolsize": {
          "type": "integer",
          "description": "Number of keys in keypool"
        },
        "keypoolsize_hd_internal": {
          "type": "integer",
          "description": "Number of internal HD keys in keypool"
        },
        "unlocked_until": {
          "type": "integer",
          "description": "Timestamp when wallet auto-locks (0 = locked/unencrypted)"
        },
        "encrypted": {
          "type": "boolean",
          "description": "Whether wallet is encrypted"
        },
        "unlocked": {
          "type": "boolean",
          "description": "Whether wallet is currently unlocked"
        },
        "hdseedid": {
          "type": "string",
          "description": "HD seed ID (if HD wallet)"
        },
        "hdmasterkeyid": {
          "type": "string",
          "description": "HD master key ID (if HD wallet)"
        },
        "scanning": {
          "type": "object",
          "description": "Blockchain scanning progress",
          "properties": {
            "active": {"type": "boolean"},
            "progress": {"type": "number", "minimum": 0, "maximum": 1},
            "duration": {"type": "integer"},
            "height": {"type": "integer"}
          }
        },
        "descriptors": {
          "type": "boolean",
          "description": "Whether wallet uses descriptors"
        },
        "external_signer": {
          "type": "boolean",
          "description": "Whether wallet uses external signer"
        },
        "blank": {
          "type": "boolean",
          "description": "Whether wallet is blank (no keys/scripts)"
        }
      },
      "required": ["walletname", "walletversion", "balance_una", "balance_din", "txcount", "encrypted", "unlocked"]
    }
  }
}
