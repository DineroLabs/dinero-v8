{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "estimatesmartfee",
  "description": "Estimate fee rate for transaction confirmation target",
  "type": "object",
  "properties": {
    "method": {
      "type": "string",
      "const": "estimatesmartfee"
    },
    "params": {
      "type": "array",
      "items": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 1008,
          "description": "Confirmation target in blocks"
        },
        {
          "type": "string",
          "enum": ["UNSET", "ECONOMICAL", "CONSERVATIVE"],
          "description": "Estimation mode (default: CONSERVATIVE)"
        }
      ],
      "minItems": 1,
      "maxItems": 2
    },
    "result": {
      "type": "object",
      "properties": {
        "feerate": {
          "type": "number",
          "description": "Estimated fee rate in una/kvB"
        },
        "feerate_din": {
          "type": "string",
          "description": "Estimated fee rate in DIN/kvB (formatted)"
        },
        "blocks": {
          "type": "integer",
          "description": "Block target used for estimation"
        },
        "errors": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Estimation errors"
        },
        "warnings": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Estimation warnings"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Estimation confidence (0-1)"
        },
        "mode": {
          "type": "string",
          "description": "Estimation mode used"
        },
        "fallback": {
          "type": "boolean",
          "description": "Whether fallback fee was used"
        },
        "min_relay_fee": {
          "type": "number",
          "description": "Minimum relay fee rate in una/kvB"
        }
      },
      "required": ["blocks"]
    }
  }
}
