{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "gettxout",
  "description": "Get unspent transaction output (UTXO) information",
  "type": "object",
  "properties": {
    "method": {
      "type": "string",
      "const": "gettxout"
    },
    "params": {
      "type": "array",
      "items": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Transaction ID"
        },
        {
          "type": "integer",
          "minimum": 0,
          "description": "Output index"
        },
        {
          "type": "boolean",
          "description": "Whether to include mempool transactions (default: true)"
        }
      ],
      "minItems": 2,
      "maxItems": 3
    },
    "result": {
      "oneOf": [
        {
          "type": "null",
          "description": "Output not found or already spent"
        },
        {
          "type": "object",
          "description": "UTXO information",
          "properties": {
            "bestblock": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "description": "Hash of block at tip of chain"
            },
            "confirmations": {
              "type": "integer",
              "description": "Number of confirmations"
            },
            "value_una": {
              "type": "integer",
              "description": "Output value in una"
            },
            "value_din": {
              "type": "string",
              "description": "Output value in DIN (formatted)"
            },
            "scriptPubKey": {
              "type": "object",
              "properties": {
                "asm": {
                  "type": "string",
                  "description": "Script assembly"
                },
                "hex": {
                  "type": "string",
                  "description": "Script hex"
                },
                "reqSigs": {
                  "type": "integer",
                  "description": "Required signatures"
                },
                "type": {
                  "type": "string",
                  "description": "Script type"
                },
                "addresses": {
                  "type": "array",
                  "items": {"type": "string"},
                  "description": "Associated addresses"
                },
                "address": {
                  "type": "string",
                  "description": "Primary address"
                }
              },
              "required": ["asm", "hex", "type"]
            },
            "coinbase": {
              "type": "boolean",
              "description": "Whether output is from coinbase transaction"
            }
          },
          "required": ["bestblock", "confirmations", "value_una", "value_din", "scriptPubKey", "coinbase"]
        }
      ]
    }
  }
}
