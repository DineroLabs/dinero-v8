[Unit]
Description=Dinero Daemon
Documentation=https://github.com/Trucker2827/dinero-cli
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/dinerod -conf=%h/.dinero/dinero.conf
User=%i
Group=%i
Restart=on-failure
RestartSec=5
LimitNOFILE=8192

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false

[Install]
WantedBy=multi-user.target

# Installation:
# sudo systemctl enable --now dinerod@$USER
# sudo systemctl status dinerod@$USER
