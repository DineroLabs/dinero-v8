# Line-ending rules.
#
# Background: in 2026-05-14, tests/integration/test_network_magic_sync.sh
# was created on a Windows machine with `core.autocrlf=true`. The blob
# pushed to GitHub happened to land as LF, but a fresh Windows checkout
# would have re-converted it to CRLF and broken bash on Linux/Mac
# (`set -euo pipefail\r` parses `pipefail\r` as the option name). This
# file makes the right answer the default for every shell-family file
# in the tree.

# Shell scripts: always LF, never CRLF. Bash on Linux/Mac chokes on
# CRLF in the shebang line or `set` builtin arguments.
*.sh   text eol=lf
*.bash text eol=lf

# Python tooling: LF for consistency with the interpreter convention.
*.py   text eol=lf

# Makefile-family: always LF.
Makefile     text eol=lf
debian/rules text eol=lf

# Windows scripts: conventionally CRLF. .bat/.cmd require it; PowerShell
# historically prefers it; NSIS scripts the same.
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.nsi  text eol=crlf
*.nsh  text eol=crlf

# Pre-existing per-file rules (now subsumed by the *.sh rule above but
# kept for explicitness — drop them when the broader rule has bedded in).
packaging/linux/build-installer.sh text eol=lf
packaging/mac/build-installer.sh   text eol=lf

# Curated OpenSSL release prebuilts: keep headers portable and archives binary.
third_party/openssl-*/prebuilt/**/include/** text eol=lf
third_party/openssl-*/prebuilt/**/*.a binary
third_party/openssl-*/prebuilt/**/*.lib binary
third_party/openssl-*/prebuilt/**/.dinero-build-meta text eol=lf

# Separation-gate baselines (spec section 8). The gates compare these
# byte-for-byte (or line-by-line) against text they generate with "\n", so a
# CRLF checkout (core.autocrlf=true, the Windows default) reads as a diff on
# every line. They stay `text` (reviewable diffs) with eol=lf, rather than
# -text, because they are hand-reviewed text baselines; the SQLite fixture
# files are binary. The two frozen FFI headers are compared byte-for-byte
# with their baseline copies by W5, so they are pinned LF as well.
tests/separation/fixtures/**/*.json      text eol=lf
tests/separation/fixtures/**/*.txt       text eol=lf
tests/separation/fixtures/**/*.md        text eol=lf
tests/separation/fixtures/**/*.db        binary
tests/separation/fixtures/**/blockchain/utxo binary
tests/separation/interface_baseline/**   text eol=lf
tests/separation/transcripts/**          text eol=lf
scripts/ci/separation/*.json             text eol=lf
scripts/ci/separation/*.txt              text eol=lf
scripts/ci/separation/*.sha256           text eol=lf
scripts/ci/separation/*.tsv              text eol=lf
include/nodecore/nodecore_ffi.h          text eol=lf
wallet-core/ffi/wallet_ffi.h             text eol=lf
