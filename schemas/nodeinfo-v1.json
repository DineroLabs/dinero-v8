{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DineroCoin NodeInfo v1 Schema",
  "description": "Schema for nodeinfo.json file generated by dinerod",
  "type": "object",
  "required": ["rpc", "ws", "cookie", "datadir", "network"],
  "properties": {
    "rpc": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^http://127\\.0\\.0\\.1:[0-9]+$",
          "description": "HTTP RPC endpoint URL"
        }
      },
      "additionalProperties": false
    },
    "ws": {
      "type": "object", 
      "required": ["url"],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^ws://127\\.0\\.0\\.1:[0-9]+/ws$",
          "description": "WebSocket RPC endpoint URL"
        }
      },
      "additionalProperties": false
    },
    "cookie": {
      "type": "string",
      "description": "Path to RPC authentication cookie file"
    },
    "datadir": {
      "type": "string",
      "description": "Daemon data directory path"
    },
    "network": {
      "type": "string",
      "enum": ["mainnet", "testnet", "regtest"],
      "description": "Active network"
    },
    "mining_address": {
      "type": "string",
      "pattern": "^(din1|rdin1)[a-z0-9]{39,87}$",
      "description": "Current mining payout address (optional)"
    }
  },
  "additionalProperties": false
}
