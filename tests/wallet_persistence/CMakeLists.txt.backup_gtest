# Phase F.6: Wallet State & Persistence Certification Tests
#
# Tests wallet persistence invariants W.1–W.7
# Certification criteria: 10/10 P0 tests passing

message(STATUS "Configuring Phase F.6 wallet persistence tests...")

# ═══════════════════════════════════════════════════════════════════════════
# Integration Tests (T1, T2, T3, T5, T10, T11)
# ═══════════════════════════════════════════════════════════════════════════

add_executable(test_wallet_persistence_f6
    test_wallet_persistence_f6.cpp
)

target_link_libraries(test_wallet_persistence_f6 PRIVATE
    dinero_wallet
    dinero_chainstate
    dinero_consensus
    dinero_crypto
    ${ROCKSDB_LIBRARY}
    secp256k1
    sqlite3
    argon2
    jsoncpp_static
    gtest
    gtest_main
)

target_include_directories(test_wallet_persistence_f6 PRIVATE
    ${CMAKE_SOURCE_DIR}/include
    ${CMAKE_SOURCE_DIR}/src
    ${CMAKE_BINARY_DIR}
    ${CMAKE_CURRENT_SOURCE_DIR}
    ${CMAKE_SOURCE_DIR}/third_party/rocksdb/include
    ${CMAKE_SOURCE_DIR}/third_party/jsoncpp/include
    ${CMAKE_SOURCE_DIR}/third_party/argon2/include
)

target_compile_definitions(test_wallet_persistence_f6 PRIVATE
    CMAKE_SOURCE_DIR="${CMAKE_SOURCE_DIR}"
)

# Add Apple frameworks if on macOS
if(APPLE)
    target_link_libraries(test_wallet_persistence_f6 PRIVATE
        "-framework Security"
        "-framework CoreFoundation"
    )
endif()

# Register integration tests with CTest
add_test(NAME WalletPersistence_T1_BalanceDeterminismRestart COMMAND test_wallet_persistence_f6 --gtest_filter=WalletPersistenceTest.T1_BalanceDeterminismAfterRestart)
add_test(NAME WalletPersistence_T2_BalanceDeterminismRescan COMMAND test_wallet_persistence_f6 --gtest_filter=WalletPersistenceTest.T2_BalanceDeterminismAfterRescan)
add_test(NAME WalletPersistence_T3_RestartUnchangedChain COMMAND test_wallet_persistence_f6 --gtest_filter=WalletPersistenceTest.T3_RestartWithUnchangedChain)
add_test(NAME WalletPersistence_T5_ChainReorgDepth1 COMMAND test_wallet_persistence_f6 --gtest_filter=WalletPersistenceTest.T5_ChainReorgDepth1)
add_test(NAME WalletPersistence_T10_RescanIdempotency COMMAND test_wallet_persistence_f6 --gtest_filter=WalletPersistenceTest.T10_RescanIdempotency)
add_test(NAME WalletPersistence_T11_MempoolNotPersisted COMMAND test_wallet_persistence_f6 --gtest_filter=WalletPersistenceTest.T11_MempoolTxNotPersisted)

set_tests_properties(
    WalletPersistence_T1_BalanceDeterminismRestart
    WalletPersistence_T2_BalanceDeterminismRescan
    WalletPersistence_T3_RestartUnchangedChain
    WalletPersistence_T5_ChainReorgDepth1
    WalletPersistence_T10_RescanIdempotency
    WalletPersistence_T11_MempoolNotPersisted
    PROPERTIES
    LABELS "f6;wallet;persistence;integration"
    TIMEOUT 60
)

