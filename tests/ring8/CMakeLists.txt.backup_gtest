#=============================================================================
# Ring 8: Evolution & Compatibility Governance Test Suite
#=============================================================================

message(STATUS "")
message(STATUS "Configuring Ring 8 Phase 8a: Backward Compatibility Enforcement...")

#=============================================================================
# Phase 8a: Backward Compatibility Enforcement (BC1-BC4)
#=============================================================================

# Phase 8a Test Executable
add_executable(test_backward_compatibility
    test_backward_compatibility.cpp
)

target_include_directories(test_backward_compatibility PRIVATE
    ${CMAKE_CURRENT_SOURCE_DIR}
    ${CMAKE_SOURCE_DIR}/include
    ${CMAKE_SOURCE_DIR}/tests
)

# Link against Ring 7 execution framework (BC tests verify Ring 7 immutability)
target_link_libraries(test_backward_compatibility PRIVATE
    execution_test_framework
    dinero_crypto
    dinero_consensus
    GTest::gtest
    GTest::gtest_main
)

# Platform-specific settings
if(APPLE)
    target_link_libraries(test_backward_compatibility PRIVATE
        "-framework Security"
        "-framework CoreFoundation"
    )
endif()

add_test(
    NAME Ring8_BackwardCompatibility_BC1-BC4
    COMMAND test_backward_compatibility
    WORKING_DIRECTORY ${CMAKE_SOURCE_DIR}
)

set_tests_properties(Ring8_BackwardCompatibility_BC1-BC4 PROPERTIES
    LABELS "ring8;phase8a;backward-compatibility;governance"
    TIMEOUT 30
)

message(STATUS "✅ Ring 8 Phase 8a backward compatibility tests configured:")
message(STATUS "   • Ring8_BackwardCompatibility_BC1-BC4 (13 tests)")
message(STATUS "   Properties:")
message(STATUS "     - BC1: Ring 7 Regression Invariance")
message(STATUS "     - BC2: Opcode Semantic Immutability")
message(STATUS "     - BC3: Script Version Immutability")
message(STATUS "     - BC4: Cross-Ring Compatibility")
message(STATUS "")
message(STATUS "Ring 8 Phase 8a Configuration Complete!")
message(STATUS "Build: cd build && cmake .. && make test_backward_compatibility")
message(STATUS "Test:  ctest -R Ring8_BackwardCompatibility --verbose")
message(STATUS "")
message(STATUS "🔒 Ring 7 semantics are now MECHANICALLY IMMUTABLE")
message(STATUS "")

