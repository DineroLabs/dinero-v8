#pragma once

// Version configuration for Dinero — generated by cmake configure_file
// The git hash IS the version. No semver.
// Guards prevent redefinition when compile definitions (-D flags) are also present.

#ifndef DINERO_CLI_GIT_SHA
#define DINERO_CLI_GIT_SHA "@GIT_HASH@"
#endif

#ifndef DINERO_GIT_COMMIT_FULL
#define DINERO_GIT_COMMIT_FULL "@GIT_HASH_FULL@"
#endif

#ifndef DINERO_CLI_BUILD_DATE
#define DINERO_CLI_BUILD_DATE "@BUILD_TIME@"
#endif
